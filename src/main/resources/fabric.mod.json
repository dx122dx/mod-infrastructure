{
	"schemaVersion": 1,
	"id": "infrastructure",
	"version": "${version}",
	"name": "Billy's Mod infrastructure",
	"description": "A general-purpose client-side infrastructure mod. Ships a debug submodule (debug actions and toggleable debug features) that activates built-in component packs only when their target mod is present.",
	"authors": [
		"billy65536"
	],
	"contact": {
		"homepage": "https://github.com/dx122dx/infrastructure",
        "sources": "https://github.com/dx122dx/infrastructure"
	},
	"license": "AGPL-3.0-only",
	"icon": "assets/infrastructure/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.billy65536.infrastructure.InfrastructureMod"
		],
		"modmenu": [
			"com.billy65536.infrastructure.debugger.integration.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"cloth-config": "*",
		"spruceui": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
